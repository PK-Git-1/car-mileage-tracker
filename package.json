{
  "name": "punch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "copy": "node -e \"const fs=require('fs');['index.html','app.js'].forEach(f=>fs.copyFileSync(f,'Deployment/'+f))\"",
    "build": "npm run copy && wrangler deploy",
    "deploy": "npm run build && node scripts/post-deploy.mjs",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
