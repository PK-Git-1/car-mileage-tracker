{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "punch",
  "compatibility_date": "2026-06-16",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./Deployment",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "punch-fuel-log",
      "database_id": "620551a5-dc3a-4e31-bee6-bf0abc6a855c"
    }
  ],
  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxmJpCuFho22A5EMWAITzEPHwO6rXCakb9MkX-cjVR0-4GFvyo5KCr3jD5qf_Iueqql9Q/exec"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
